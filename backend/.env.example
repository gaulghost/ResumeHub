# ==============================================================================
# ResumeHub Backend Environment Configuration Template
# Rename this file to .env and fill in your keys.
# ==============================================================================

# Groq API keys (used for salary estimation + rewrite fallback chain)
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here

# Gemini API keys (used for resume parse + rewrite fallback chain)
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here

# Optional source IPs for multi-egress outbound AI requests
EGRESS_IP_1=
EGRESS_IP_2=

# SQLite database file path (defaults to resumehub.db)
DB_PATH=resumehub.db

# Admin dashboard secret (required — /admin rejects requests without a match)
ADMIN_SECRET=your_admin_secret_here

# FREE_MODE=true (default): API endpoints stay open (backward compatible).
# FREE_MODE=false: require header X-ResumeHub-Key == RESUMEHUB_API_SECRET
FREE_MODE=true

# Shared secret for extension ↔ backend when FREE_MODE=false.
# Leave empty while FREE_MODE=true. Also set BACKEND.API_SECRET in
# core/config/constants.js to the same value for the extension build.
RESUMEHUB_API_SECRET=

# Max jobs accepted per /api/salary-estimate batch (default 20)
MAX_JOBS_PER_BATCH=20

# Per-IP request rate limit for API endpoints (requests per minute)
RATE_LIMIT_PER_MINUTE=60
# Used when FREE_MODE=false
LOCKED_RATE_LIMIT_PER_MINUTE=30
