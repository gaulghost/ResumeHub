{
    "manifest_version": 3,
    "name": "ResumeHub AI: Smart Resume Tailoring & Salary Insights",
    "version": "1.10",
    "description": "Instantly tailor your resume to match job descriptions and view salary estimations on LinkedIn, Naukri, and Instahyre.",
    "author": "Pradhuman Singh",
    "homepage_url": "https://github.com/gaulghost",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://*.linkedin.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://resumehub.duckdns.org/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "assets/logo128.png",
            "48": "assets/logo128.png",
            "128": "assets/logo128.png"
        }
    },
    "icons": {
        "16": "assets/logo128.png",
        "48": "assets/logo128.png",
        "128": "assets/logo128.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.linkedin.com/jobs/**"
            ],
            "js": [
                "content-scripts/linkedin/linkedin-controller.js"
            ]
        },
        {
            "matches": [
                "https://*.naukri.com/*"
            ],
            "js": [
                "content-scripts/naukri/naukri-controller.js"
            ]
        },
        {
            "matches": [
                "https://*.instahyre.com/*"
            ],
            "js": [
                "content-scripts/instahyre/instahyre-controller.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "lib/pdfmake.min.js",
                "lib/vfs_fonts.js",
                "utils/pdf-generator.js",
                "utils/docx-generator.js"
            ],
            "matches": [
                "https://*.linkedin.com/*",
                "https://*.naukri.com/*",
                "https://*.instahyre.com/*"
            ]
        },
        {
            "resources": [
                "content-scripts/linkedin/config/selectors.js"
            ],
            "matches": [
                "https://*.linkedin.com/*"
            ]
        }
    ]
}